{
  "name": "opencode-canvas",
  "version": "0.1.0",
  "description": "Review canvases on your machine, connected to your local OpenCode: post images, videos and HTML from sessions, seed canvases from their media, and bring sessions onto a canvas as creatures you can talk to.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlongster/opencode-canvas.git"
  },
  "bin": {
    "opencode-canvas": "./bin/opencode-canvas.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "server": "bun --watch server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "check:build": "bun run scripts/check-build.ts",
    "start": "bun server/index.ts",
    "local": "bun bin/opencode-canvas.ts",
    "seed": "bun scripts/seed.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode/client": "^2.0.29",
    "lib0": "^0.2.119",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.60",
    "marked": "^18.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "y-websocket": "^3.1.0"
  }
}
